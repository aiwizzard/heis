{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "rootDir": ".",
    "outDir": "../dist-electron",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": false,
    "types": [
      "node"
    ],
    "paths": {
      "@heis/core": [
        "./packages/core/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
