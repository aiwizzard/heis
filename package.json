{
  "name": "heis",
  "description": "AI image, video, cinema, audio, workflow, and agent studio for macOS",
  "homepage": "https://github.com/aiwizzard/heis",
  "private": true,
  "version": "2.0.0",
  "license": "SEE LICENSE IN COMMERCIAL_LICENSE.md",
  "workspaces": [
    "apps/web",
    "packages/core",
    "packages/studio",
    "packages/heis-workflow/packages/workflow-builder",
    "packages/heis-agents/packages/agents",
    "packages/heis-agent/packages/design-agent"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "web:dev": "npm run dev -w @heis/web",
    "web:build": "npm run build -w @heis/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:tests": "tsc -p tests/tsconfig.json",
    "test": "npm run build:tests && node --test dist-tests/tests/*.test.js",
    "security:scan": "node scripts/scan-secrets.js",
    "build:studio": "npm run build -w studio",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design": "npm run build -w design-agent",
    "build:core": "npm run build -w @heis/core",
    "build:packages": "npm run build:core && npm run build:workflow && npm run build:agent && npm run build:design && npm run build:studio",
    "setup": "npm install && npm run build:packages",
    "build:desktop-renderer": "npm run build:packages && next build",
    "electron:dev": "npm run build:desktop-renderer && npm run build:electron && electron .",
    "electron:build": "npm run build:desktop-renderer && npm run build:electron && electron-builder --mac",
    "electron:build:arm64": "npm run build:desktop-renderer && npm run build:electron && electron-builder --mac --arm64",
    "electron:build:x64": "npm run build:desktop-renderer && npm run build:electron && electron-builder --mac --x64",
    "stage:local-ai": "node scripts/stage-local-ai-binary.js",
    "package:linux:deb": "node scripts/package-linux-deb.js",
    "package:linux:deb:arm64": "node scripts/package-linux-deb.js --arch arm64",
    "package:linux:deb:x64": "node scripts/package-linux-deb.js --arch x64",
    "electron:build:all": "npm run electron:build"
  },
  "build": {
    "appId": "com.heis.desktop",
    "productName": "Heis",
    "copyright": "Copyright © 2026 Heis",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "afterSign": "./scripts/notarize.cjs",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.heis.app/mac",
        "channel": "latest"
      }
    ],
    "files": [
      "dist-electron/**/*",
      "packages/core/dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next/standalone"
      },
      {
        "from": ".next/static",
        "to": "next/standalone/.next/static"
      },
      {
        "from": "public",
        "to": "next/standalone/public"
      },
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "public/banner.png",
      "category": "Utility",
      "maintainer": "heis Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@heis/core": "*",
    "@supabase/supabase-js": "^2.57.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.14",
    "ai-agent": "file:./packages/heis-agents/packages/agents",
    "axios": "^1.7.0",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "*",
    "workflow-builder": "file:./packages/heis-workflow/packages/workflow-builder",
    "xtend": "^4.0.2",
    "autoprefixer": "^10.4.24",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.3"
  }
}
