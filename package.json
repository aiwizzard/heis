{
  "name": "heis",
  "description": "AI image, video, cinema, audio, workflow, and agent studio for macOS",
  "homepage": "https://github.com/aiwizzard/heis",
  "private": true,
  "version": "2.0.0",
  "license": "SEE LICENSE IN COMMERCIAL_LICENSE.md",
  "workspaces": [
    "apps/landing",
    "apps/web",
    "packages/core",
    "packages/studio",
    "packages/heis-workflow/packages/workflow-builder",
    "packages/heis-agents/packages/agents",
    "packages/heis-agent/packages/design-agent",
    "packages/editor"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "web:dev": "npm run dev -w @heis/web",
    "web:build": "npm run build -w @heis/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:electron": "npm run prepare:codex && node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p electron/tsconfig.json && node scripts/finalize-electron-preload.js",
    "build:tests": "tsc -p tests/tsconfig.json",
    "test": "npm run build:tests && node --test dist-tests/tests/*.test.js",
    "security:scan": "node scripts/scan-secrets.js",
    "build:studio": "npm run build -w studio",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design": "npm run build -w design-agent",
    "build:core": "npm run build -w @heis/core",
    "build:packages": "npm run build:core && npm run build:workflow && npm run build:agent && npm run build:design && npm run build:studio",
    "setup": "npm install && npm run build:packages",
    "stage:next-standalone": "node scripts/stage-next-standalone.js",
    "build:desktop-renderer": "vite build",
    "electron:dev": "npm run build:core && npm run build:desktop-renderer && npm run build:electron && node scripts/start-desktop.mjs",
    "electron:build": "npm run build:core && npm run build:desktop-renderer && npm run build:electron && electron-builder --mac",
    "electron:build:arm64": "npm run build:core && npm run build:desktop-renderer && npm run build:electron && electron-builder --mac --arm64",
    "electron:build:x64": "npm run build:core && npm run build:desktop-renderer && npm run build:electron && electron-builder --mac --x64",
    "stage:local-ai": "node scripts/stage-local-ai-binary.js",
    "package:linux:deb": "node scripts/package-linux-deb.js",
    "package:linux:deb:arm64": "node scripts/package-linux-deb.js --arch arm64",
    "package:linux:deb:x64": "node scripts/package-linux-deb.js --arch x64",
    "electron:build:all": "npm run electron:build",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "prepare:codex": "node -e \"import('./scripts/prepare-codex.mjs').then(m=>m.prepareCodex())\"",
    "test:agent": "node scripts/test-codex.mjs",
    "typecheck:agent": "tsc -p electron/agent/tsconfig.json",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "brand:export": "node scripts/export-brand.mjs",
    "landing:dev": "npm run dev -w @heis/landing",
    "landing:build": "npm run build -w @heis/landing",
    "typecheck:editor": "tsc -p packages/editor/tsconfig.json && tsc -p electron/editor/tsconfig.json",
    "test:editor": "npm run build:core && npm run build:tests && node --test dist-tests/tests/editor*.test.js",
    "test:editor-desktop": "node scripts/editor-smoke.mjs",
    "build:media-runtime": "node scripts/build-media-runtime.mjs",
    "test:clipping-desktop": "node scripts/clipping-smoke.mjs",
    "test:workflow-hosted": "node --test scripts/workflow-hosted.test.mjs",
    "test:workflow-desktop": "node scripts/workflow-smoke.mjs",
    "test:design-desktop": "node scripts/design-smoke.mjs",
    "test:layers-desktop": "node scripts/layers-smoke.mjs",
    "test:editor-captions": "node scripts/editor-caption-smoke.mjs",
    "desktop:editor": "HEIS_EDITOR=1 node scripts/desktop-dev.mjs"
  },
  "build": {
    "appId": "com.heis.desktop",
    "productName": "Heis",
    "copyright": "Copyright \u00a9 2026 Heis",
    "directories": {
      "output": "release"
    },
    "afterSign": "./scripts/notarize.cjs",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.heis.app/mac",
        "channel": "latest"
      }
    ],
    "files": [
      "dist-electron/**/*",
      "packages/core/dist/**/*",
      "!node_modules/@openai/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-desktop",
        "to": "desktop"
      },
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-codex",
        "to": "codex-runtime"
      },
      {
        "from": "build/media-runtime/${arch}",
        "to": "media-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/heis.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg"
      ],
      "binaries": [
        "Contents/Resources/media-runtime/ffmpeg",
        "Contents/Resources/media-runtime/ffprobe",
        "Contents/Resources/media-runtime/whisper-cli"
      ]
    },
    "win": {
      "icon": "build/heis.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/heis.png",
      "category": "Utility",
      "maintainer": "heis Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "beforePack": "./scripts/prepare-package.cjs"
  },
  "dependencies": {
    "@heis/core": "*",
    "@openai/codex": "0.154.0",
    "@supabase/supabase-js": "^2.57.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "0.564.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@electron/notarize": "^3.1.1",
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.0",
    "ai-agent": "file:./packages/heis-agents/packages/agents",
    "autoprefixer": "^10.4.24",
    "axios": "^1.7.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "next": "^16.3.5",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "*",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "workflow-builder": "file:./packages/heis-workflow/packages/workflow-builder",
    "xtend": "^4.0.2"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.3"
  }
}
