{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "ai-agent": [
        "./packages/heis-agents/packages/agents/src/index.ts"
      ],
      "workflow-builder": [
        "./packages/heis-workflow/packages/workflow-builder/src/index.ts"
      ],
      "design-agent": [
        "./packages/heis-agent/packages/design-agent/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "src/**/*.ts",
    "proxy.ts",
    "packages/studio/src/**/*.ts",
    "packages/studio/src/**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "dist-electron",
    "dist-tests"
  ]
}
